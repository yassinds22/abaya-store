# ======================================================
# لارين عباية (Lareen Abaya) - Production & Local .htaccess
# متوافق مع الاستضافات العامة (cPanel / Shared / VPS) والتنمية المحلية
# ======================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. تحويل الطلبات التي تحتوي على .php إلى الرابط النظيف (HTTP 301 Redirect)
    RewriteCond %{THE_REQUEST} \s/(.+)\.php[\s?] [NC]
    RewriteRule ^(.+)\.php$ $1 [R=301,L]

    # 2. استثناء الملفات والمجلدات الحقيقية (CSS, JS, Images, Uploads)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. تحويل أي مسار بدون .php إلى ملف الـ PHP المقابل تلقائياً
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L,QSA]
</IfModule>
